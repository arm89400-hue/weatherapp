# Postgres
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather
POSTGRES_DB=weather
DATABASE_URL=postgresql://weather:weather@postgres:5432/weather

# Redis
REDIS_URL=redis://redis:6379

# Backend
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Auth secrets — generate real random values for anything beyond local dev,
# e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# TMD open data API — register at https://data.tmd.go.th to obtain these
TMD_API_UID=
TMD_API_UKEY=
TMD_API_BASE_URL=https://data.tmd.go.th/api

# Push notifications (Expo). Sending pushes needs no secret at all — the backend just calls
# Expo's push API with each device's token. This is optional and only makes Expo enforce that
# push requests actually come from your account: generate one at https://expo.dev (Account
# settings -> Access tokens) if you want it.
EXPO_ACCESS_TOKEN=
