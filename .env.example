# Postgres
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather
POSTGRES_DB=weather
DATABASE_URL=postgresql://weather:weather@postgres:5432/weather

# Redis
REDIS_URL=redis://redis:6379

# Backend
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Auth secrets — generate real random values for anything beyond local dev,
# e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# TMD open data API — register at https://data.tmd.go.th to obtain these
TMD_API_UID=
TMD_API_UKEY=
TMD_API_BASE_URL=https://data.tmd.go.th/api

# Web Push (VAPID) — generate your own with `npx web-push generate-vapid-keys` (no external
# account needed). VAPID_SUBJECT must be a mailto: address or https: URL per the Web Push spec.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
